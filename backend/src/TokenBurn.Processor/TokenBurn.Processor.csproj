<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>TokenBurn.Processor</AssemblyName>
    <RootNamespace>TokenBurn.Processor</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TokenBurn.Common/TokenBurn.Common.csproj" />
    <ProjectReference Include="../TokenBurn.Contracts/TokenBurn.Contracts.csproj" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Elastic.Clients.Elasticsearch" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Otlp/protos/**/*.proto" ProtoRoot="Otlp/protos" GrpcServices="None" Access="Internal" />
  </ItemGroup>
</Project>
