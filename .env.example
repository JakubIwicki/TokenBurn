# PostgreSQL bootstrap credentials.
POSTGRES_USER=tokenburn_admin
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=tokenburn
INGEST_DB_PASSWORD=replace-with-ingest-password
PROCESSOR_DB_PASSWORD=replace-with-processor-password
INSIGHTS_DB_PASSWORD=replace-with-insights-password
IDENTITY_DB_PASSWORD=replace-with-identity-password

# Elasticsearch and internal service endpoints.
ELASTIC_PASSWORD=replace-with-elasticsearch-password
ELASTIC_DISCOVERY_TYPE=single-node
ELASTIC_SECURITY_ENABLED=true
ES_JAVA_OPTS=-Xms512m -Xmx512m
ELASTICSEARCH_URI=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
EMBEDDINGS_URI=http://embeddings:80

# Kafka KRaft single-broker configuration.
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_ALLOW_PLAINTEXT_LISTENER=yes
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Processor replay (backfills Elasticsearch from agent_runs at startup).
PROCESSOR_REPLAY_ENABLED=false

# Processor embeddings / documents import. Embeddings are OFF by default; the documents
# corpus is imported from DOCUMENTS_DIR via the /api/imports command.
PROCESSOR_EMBEDDINGS_ENABLED=false
DOCUMENTS_DIR=/path/to/your/documents
DOCUMENTS_CHUNK_MAX_TOKENS=512
DOCUMENTS_TOKEN_CHARS_PER_TOKEN=4
DOCUMENTS_MAX_FILE_BYTES=5000000
DOCUMENTS_EMBEDDING_BATCH_SIZE=64

# Processor self-telemetry: the Processor reports its own runs back to TokenBurn via the
# tokenburn-self identity client and the ingest endpoint. Off by default; set a client secret
# to enable. A blank IDENTITY__SELFTELEMETRYCLIENTSECRET boots the stack without the client.
SELF_TELEMETRY_ENABLED=false
SELF_TELEMETRY_INTERVAL_MINUTES=60
IDENTITY__SELFTELEMETRYCLIENTSECRET=

# Ask (RAG). The fake client is the DEFAULT in every environment (privacy-boundary rule 7);
# DeepSeek is opt-in per environment and never a runtime fallback. A blank ASK_DEEPSEEK_API_KEY
# with ASK_PROVIDER=deepseek fails loud at startup rather than silently falling back.
ASK_PROVIDER=fake
ASK_DEEPSEEK_API_KEY=
ASK_DEEPSEEK_ENDPOINT=

# Application connection strings. Replace placeholders before starting Compose.
INGEST_CONNECTION_STRING=Host=postgres;Port=5432;Database=tokenburn;Username=ingest_role;Password=replace-with-ingest-password
PROCESSOR_CONNECTION_STRING=Host=postgres;Port=5432;Database=tokenburn;Username=processor_role;Password=replace-with-processor-password
INSIGHTS_CONNECTION_STRING=Host=postgres;Port=5432;Database=tokenburn;Username=insights_role;Password=replace-with-insights-password
IDENTITY_CONNECTION_STRING=Host=postgres;Port=5432;Database=tokenburn_identity;Username=identity_role;Password=replace-with-identity-password
JWT_AUTHORITY_URL=https://localhost/connect
JWT_METADATA_ADDRESS=http://identity:8080/.well-known/openid-configuration
CLAUDE_TRANSCRIPTS_DIR=/path/to/your/claude/projects
IDENTITY__COLLECTORCLIENTSECRET=replace-with-collector-client-secret
IDENTITY__DEVUSER__USERNAME=dev@example.local
IDENTITY__DEVUSER__PASSWORD=replace-with-dev-password
ASPNETCORE_URLS=http://+:8080
NODE_ENV=production
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=https://localhost
# Internal compose-network address of the Insights API, used for server-side SSR/ISR fetches.
# NEXT_PUBLIC_API_BASE_URL stays the public https://localhost for anything client-side.
API_INTERNAL_URL=http://insights:8080
