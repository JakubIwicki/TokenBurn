<UserControl x:Class="TokenBurn.Desktop.Features.Search.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="search" Style="{StaticResource ViewTitleTextStyle}" />

        <!-- Query + mode + search -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox Width="360" Style="{StaticResource TerminalTextBoxStyle}"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="110" Margin="8,0,0,0" Style="{StaticResource TerminalComboBoxStyle}"
                      SelectedValue="{Binding Mode}" SelectedValuePath="Tag">
                <ComboBoxItem Content="hybrid" Tag="hybrid" />
                <ComboBoxItem Content="keyword" Tag="keyword" />
            </ComboBox>
            <Button Content="search" Margin="8,0,0,0"
                    Command="{Binding RefreshCommand}" Style="{StaticResource TerminalButtonStyle}" />
        </StackPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
            <TextBox Width="120" Style="{StaticResource TerminalTextBoxStyle}"
                     Text="{Binding ModelFilter, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text=" model" Style="{StaticResource DimLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="120" Style="{StaticResource TerminalTextBoxStyle}"
                     Text="{Binding PersonaFilter, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text=" persona" Style="{StaticResource DimLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="100" Style="{StaticResource TerminalTextBoxStyle}"
                     Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text=" source" Style="{StaticResource DimLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="100" Style="{StaticResource TerminalTextBoxStyle}"
                     Text="{Binding StatusFilter, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text=" status" Style="{StaticResource DimLabelTextStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Total + paging -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource DimLabelTextStyle}" VerticalAlignment="Center">
                <Run Text="total " />
                <Run Text="{Binding Total}" />
            </TextBlock>
            <Button Content="load more" Margin="16,0,0,0"
                    Command="{Binding LoadMoreCommand}" Style="{StaticResource TerminalButtonStyle}" />
        </StackPanel>

        <!-- Results feed -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Hits}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                    Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Rank, StringFormat={}{0,3}}" Style="{StaticResource CellTextStyle}"
                                                   Foreground="{StaticResource TextMutedBrush}" Width="28" />
                                        <TextBlock Text="{Binding Session}" Style="{StaticResource CellTextStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontWeight="{StaticResource FontWeightSemibold}" />
                                        <TextBlock Text="  " Style="{StaticResource CellTextStyle}" />
                                        <TextBlock Text="{Binding Model}" Style="{StaticResource CellTextStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="  " Style="{StaticResource CellTextStyle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource StatusDotStyle}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource CellTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding StartedAt}" Style="{StaticResource CellTextStyle}"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0" />
                                        <TextBlock Text="{Binding Tokens}" Style="{StaticResource CellTextStyle}"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0" />
                                        <TextBlock Text="{Binding Cost}" Style="{StaticResource CellTextStyle}"
                                                   Foreground="{StaticResource SpendBrush}" FontWeight="{StaticResource FontWeightSemibold}"
                                                   Margin="12,0,0,0" />
                                        <TextBlock Text="{Binding PricingStatus}" Style="{StaticResource CoverageStatusTextStyle}"
                                                   Margin="12,0,0,0" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding DiffChrome}" Margin="28,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource CellTextStyle}"
                                                           Foreground="{StaticResource SuccessBrush}" FontSize="{StaticResource FontSizeData}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="no hits — adjust the query"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Hits.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Background="{StaticResource OverlayBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="loading…" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
    </Grid>
</UserControl>
