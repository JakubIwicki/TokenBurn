<UserControl x:Class="TokenBurn.Desktop.Features.RunDetail.RunDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="run detail" Style="{StaticResource ViewTitleTextStyle}" />

        <!-- Run header -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource CellTextStyle}">
                    <Run Text="session " Foreground="{StaticResource TextMutedBrush}" />
                    <Run Text="{Binding Run.SessionId}" />
                </TextBlock>
                <TextBlock Style="{StaticResource CellTextStyle}" Margin="0,4,0,0">
                    <Run Text="persona " Foreground="{StaticResource TextMutedBrush}" />
                    <Run Text="{Binding Run.Persona}" />
                    <Run Text="   model " Foreground="{StaticResource TextMutedBrush}" />
                    <Run Text="{Binding Run.ModelSlug}" />
                    <Run Text="   status " Foreground="{StaticResource TextMutedBrush}" />
                    <Run Text="{Binding Run.Status}" />
                </TextBlock>
                <TextBlock Style="{StaticResource CellTextStyle}" Margin="0,4,0,0">
                    <Run Text="in " Foreground="{StaticResource TextMutedBrush}" />
                    <Run Text="{Binding Run.InputTokens, StringFormat={}{0:N0}}" />
                    <Run Text="  out " Foreground="{StaticResource TextMutedBrush}" />
                    <Run Text="{Binding Run.OutputTokens, StringFormat={}{0:N0}}" />
                    <Run Text="  cost " Foreground="{StaticResource TextMutedBrush}" />
                    <Run Text="{Binding Run.CostUsd, StringFormat={}{0:$0.00}}" Foreground="{StaticResource SpendBrush}" />
                    <Run Text="  coverage " Foreground="{StaticResource TextMutedBrush}" />
                    <Run Text="{Binding Run.PricingStatus}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="no run selected — pick a run from the runs table"
                   Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource DimLabelTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Run}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Row="3" Text="findings" Style="{StaticResource SectionLabelTextStyle}" Margin="0,14,0,4" />

        <!-- Findings table -->
        <Grid Grid.Row="4">
            <ListView ItemsSource="{Binding Findings}"
                      ItemContainerStyle="{StaticResource TerminalListItemStyle}"
                      Background="Transparent" BorderThickness="0">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource TerminalColumnHeaderStyle}">
                        <GridViewColumn Header="severity" Width="120">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="severity" Style="{StaticResource ColumnHeaderTextStyle}" />
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource SeverityDotStyle}" Margin="8,0,6,0" />
                                        <TextBlock Text="{Binding Severity}" Style="{StaticResource CellTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="kind" Width="180">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="kind" Style="{StaticResource ColumnHeaderTextStyle}" />
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource CellTextStyle}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="wasted cost" Width="120">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="wasted cost" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding WastedCostUsd, StringFormat={}{0:$0.00}}" Style="{StaticResource CellTextStyle}"
                                               Foreground="{StaticResource SpendBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="coverage" Width="90">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="coverage" Style="{StaticResource ColumnHeaderTextStyle}" />
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="n/a" Style="{StaticResource CoverageStatusTextStyle}" Margin="8,0,0,0" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="detected" Width="150">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="detected" Style="{StaticResource ColumnHeaderTextStyle}" />
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DetectedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Style="{StaticResource CellTextStyle}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="ack" Width="150">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="ack" Style="{StaticResource ColumnHeaderTextStyle}" />
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AcknowledgedAt, TargetNullValue=—, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Style="{StaticResource CellTextStyle}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Background="{StaticResource OverlayBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="loading…" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Message feed empty state (feed is empty by design in this phase) -->
        <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                Padding="10" Margin="0,8,0,0">
            <TextBlock Text="{Binding MessagesEmptyText}" Style="{StaticResource DimLabelTextStyle}" />
        </Border>

        <TextBlock Grid.Row="6" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
    </Grid>
</UserControl>
