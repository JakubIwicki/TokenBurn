<UserControl x:Class="TokenBurn.Desktop.Features.Ask.AskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ask" Style="{StaticResource ViewTitleTextStyle}" />

        <!-- Question + ask -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0"
                    IsEnabled="{Binding HasAskScope}">
            <TextBox Width="360" Style="{StaticResource TerminalTextBoxStyle}"
                     Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="ask" Margin="8,0,0,0"
                    Command="{Binding AskCommand}" Style="{StaticResource TerminalButtonStyle}" />
        </StackPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8"
                    IsEnabled="{Binding HasAskScope}">
            <TextBox Width="110" Style="{StaticResource TerminalTextBoxStyle}"
                     Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text=" model" Style="{StaticResource DimLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="110" Style="{StaticResource TerminalTextBoxStyle}"
                     Text="{Binding Persona, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text=" persona" Style="{StaticResource DimLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="100" Style="{StaticResource TerminalTextBoxStyle}"
                     Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text=" source" Style="{StaticResource DimLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="100" Style="{StaticResource TerminalTextBoxStyle}"
                     Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text=" status" Style="{StaticResource DimLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker Width="130" Style="{StaticResource TerminalDatePickerStyle}"
                        SelectedDate="{Binding From, Converter={StaticResource OffsetToDate}}" />
            <TextBlock Text=" to " Style="{StaticResource DimLabelTextStyle}" VerticalAlignment="Center" Margin="4,0,0,0" />
            <DatePicker Width="130" Margin="0,0,8,0" Style="{StaticResource TerminalDatePickerStyle}"
                        SelectedDate="{Binding To, Converter={StaticResource OffsetToDate}}" />
        </StackPanel>

        <!-- Answer + coverage + citations + retrieval -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="coverage " Style="{StaticResource DimLabelTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PricingCoverageText}" Style="{StaticResource CellTextStyle}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="{StaticResource FontWeightSemibold}" />
                </StackPanel>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                        Padding="10" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Answer}" Style="{StaticResource CellTextStyle}"
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="citations" Style="{StaticResource SectionLabelTextStyle}" Margin="0,4,0,4" />
                <ItemsControl ItemsSource="{Binding Citations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                    Padding="8" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource CellTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}" Width="70" />
                                    <TextBlock Text="{Binding Ref}" Style="{StaticResource CellTextStyle}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="{StaticResource FontWeightSemibold}" />
                                    <TextBlock Text="  " Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Text="{Binding Excerpt}" Style="{StaticResource CellTextStyle}"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="retrieval" Style="{StaticResource SectionLabelTextStyle}" Margin="0,8,0,4" />
                <ItemsControl ItemsSource="{Binding Retrieval}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                    Padding="8" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource CellTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}" Width="70" />
                                    <TextBlock Text="{Binding Ref}" Style="{StaticResource CellTextStyle}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="{StaticResource FontWeightSemibold}" />
                                    <TextBlock Text="  " Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Text="{Binding Persona}" Style="{StaticResource CellTextStyle}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="  " Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Text="{Binding Model}" Style="{StaticResource CellTextStyle}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="  " Style="{StaticResource CellTextStyle}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource StatusDotStyle}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource CellTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StartedAt}" Style="{StaticResource CellTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding Tokens}" Style="{StaticResource CellTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding Cost}" Style="{StaticResource CellTextStyle}"
                                               Foreground="{StaticResource SpendBrush}" FontWeight="{StaticResource FontWeightSemibold}"
                                               Margin="12,0,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{StaticResource OverlayBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="loading…" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

        <!-- Defensive lock: the ask.invoke scope is required for this feature. Rendered last so it
             sits above the input surface; Collapsed by default, revealed when the scope is missing. -->
        <Border Grid.RowSpan="5" Background="{StaticResource OverlayBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAskScope}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Ask requires the ask.invoke scope."
                           Style="{StaticResource ErrorTextStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="sign in with the ask.invoke scope to enable this feature."
                           Style="{StaticResource DimLabelTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
