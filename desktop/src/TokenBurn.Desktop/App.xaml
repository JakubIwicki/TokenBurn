<Application x:Class="TokenBurn.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TokenBurn.Desktop.Features.Common"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/TerminalPalette.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
            <conv:ToListConverter x:Key="ToList" />
            <conv:CoverageToBrushConverter x:Key="CoverageToBrush" />
            <conv:DateTimeOffsetConverter x:Key="OffsetToDate" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
