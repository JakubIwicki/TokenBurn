<Window x:Class="TokenBurn.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TokenBurn.Desktop.Features.Shell"
        Title="tb ▸ TokenBurn · operator console"
        Width="1180" Height="760"
        MinWidth="860" MinHeight="520"
        Background="{StaticResource ChromeBrush}"
        Foreground="{StaticResource TextContentBrush}"
        FontFamily="{StaticResource TerminalFont}"
        FontSize="{StaticResource FontSizeBody}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title strip -->
        <Border Grid.Row="0" Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="tb ▸ TokenBurn · operator console"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeData}"
                           FontWeight="{StaticResource FontWeightSemibold}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeData}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="not signed in" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                    <Setter Property="Text" Value="✓ 127.0.0.1:7891" />
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Grid.Column="2" Content="sign in" Margin="0,0,8,0"
                        Command="{Binding SignInCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TerminalButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="3" Content="sign out"
                        Command="{Binding SignOutCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TerminalButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Body: nav rail + active feature -->
        <views:ShellView Grid.Row="1" />

        <!-- Footer: burn ticker (permanent). DataContext set to the BurnTickerViewModel in code-behind. -->
        <Border Grid.Row="2" x:Name="BurnTickerFooter"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock FontSize="{StaticResource FontSizeData}">
                <Run Text="usage ▸ " Foreground="{StaticResource TextMutedBrush}" />
                <Run Text="{Binding InputTokensText}" Foreground="{StaticResource TextContentBrush}" />
                <Run Text=" in · " Foreground="{StaticResource TextMutedBrush}" />
                <Run Text="{Binding OutputTokensText}" Foreground="{StaticResource TextContentBrush}" />
                <Run Text=" · " Foreground="{StaticResource TextMutedBrush}" />
                <Run Text="{Binding CostText}" Foreground="{StaticResource SpendBrush}" FontWeight="{StaticResource FontWeightSemibold}" />
                <Run Text=" · coverage " Foreground="{StaticResource TextMutedBrush}" />
                <Run Text="{Binding CoverageText}" Foreground="{StaticResource TextContentBrush}" />
            </TextBlock>
        </Border>
    </Grid>
</Window>
