<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Japanese Flower / ds-view terminal palette (blueprint §Palette). Exact hexes, no tints. -->
    <SolidColorBrush x:Key="ChromeBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#201A28" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#2A2433" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#3A2A4D" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#3A2A4D" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#D7AFFF" />
    <SolidColorBrush x:Key="TextContentBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9A8AAA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5F5F5F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#AFD7FF" />
    <SolidColorBrush x:Key="SpendBrush" Color="#FF8C42" />
    <SolidColorBrush x:Key="WarnBrush" Color="#D7AF5F" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF5F87" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#87D787" />
    <SolidColorBrush x:Key="ActiveBrush" Color="#D7AFFF" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000" />

</ResourceDictionary>
